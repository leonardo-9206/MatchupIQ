# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=matchupiq_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# External APIs (The Odds API)
ODDS_API_KEY=your_the_odds_api_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Set to false in local development to preserve monthly API quota on page reloads (F5).
# Only explicit requests with refresh=1 will trigger external cURL calls when false.
ODDS_AUTO_FETCH=false
